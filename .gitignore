# Raw screen recordings. Git keeps every byte forever, so only the encoded
# README asset under assets/readme/ is committed.
assets/*.mp4
assets/*.mov
assets/*.mkv

# Tracks kept around for measuring against. Somebody's music, not project
# assets — and git would carry every byte of them forever.
examples/
